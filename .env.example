# Copiar a .env y completar. El archivo .env no se versiona.

# --- Base de datos (contenedor pgvector) ---
POSTGRES_USER=arquiwiki
POSTGRES_PASSWORD=change-me
POSTGRES_DB=arquiwiki

# --- Puertos publicados solo en 127.0.0.1 ---
PGVECTOR_PORT=5432
API_PORT=8000
RAG_PORT=8001
GATEWAY_PORT=8002

# --- RAG (kb-rag) ---
# Sin clave, /query devuelve solo los fragmentos recuperados (llm: disabled).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_TOP_K=5

# --- mcp-gateway: un token Bearer por rol (generar con: openssl rand -hex 24) ---
GATEWAY_TOKEN_INGESTOR=change-me-ingestor
GATEWAY_TOKEN_CONSULTOR=change-me-consultor
GATEWAY_TOKEN_AUDITOR=change-me-auditor

# --- UID/GID con que corren vault-init y mcp-gateway sobre el vault ---
# En Linux usar: HOST_UID=$(id -u) HOST_GID=$(id -g)
HOST_UID=1000
HOST_GID=1000
